@model List<RaceDay.Contracts.DTOs.ResultDto>
@{ ViewData["Title"] = "My results"; }

<h2>My results</h2>
<table class="table bg-white">
    <thead>
        <tr><th>Event</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.EventName</td>
                <td>@r.CategoryName</td>
                <td>@TimeSpan.FromSeconds(r.FinishTimeSeconds)</td>
                <td><span class="badge bg-primary">@r.Position</span></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-muted">No results yet - good luck at your next race!</td></tr>
        }
    </tbody>
</table>
