@model List<RaceDay.Contracts.DTOs.EnrolmentDto>
@{ ViewData["Title"] = "Entrants"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Entrants</h2>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to events</a>
</div>

<table class="table bg-white">
    <thead>
        <tr><th>Runner</th><th>Category</th><th>Enrolled at</th><th>Capture result</th></tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.UserName</td>
                <td>@e.CategoryName</td>
                <td class="text-muted">@e.EnrolledAtUtc.ToLocalTime().ToString("g")</td>
                <td>
                    <form asp-action="AddResult" method="post" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@ViewBag.EventId" />
                        <input type="hidden" name="enrolmentId" value="@e.Id" />
                        <input name="finishTimeSeconds" class="form-control form-control-sm" style="max-width:110px" placeholder="Seconds" required />
                        <input name="position" type="number" class="form-control form-control-sm" style="max-width:80px" placeholder="Pos" required />
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-muted">No entrants yet.</td></tr>
        }
    </tbody>
</table>
