<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f6f7fb; }
        .navbar-brand { font-weight: 700; }
        .card { border: 0; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Events" asp-action="Index">RaceDay</a>
        <div class="navbar-nav flex-row gap-3">
            <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
            <a class="nav-link" asp-controller="Events" asp-action="Enrolments">My Enrolments</a>
            <a class="nav-link" asp-controller="Events" asp-action="Results">My Results</a>
        </div>
        <div class="ms-auto d-flex gap-2">
            @if (Context.Session.GetString("RaceDay.Jwt") is not null)
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Profile">Profile</a>
                <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Logout">Log out</a>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Register">Register</a>
            }
        </div>
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @RenderBody()
</main>
</body>
</html>
